on:
  push:
    tags:
      - "v*"  # 匹配 v1.0.0、v2.1.3 等标签
 
 jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4  # 拉取代码
      - name: 上传文件到 Release
        uses: svenstaro/upload-release-action@v2
        with:
          repo_token: ${{ secrets.GITHUB_TOKEN }}  # GitHub 自动提供的密钥
          file: ./dist/your-file.zip  # 要上传的文件路径
          tag: ${{ github.ref_name }}  # 使用触发的标签作为版本号
 
